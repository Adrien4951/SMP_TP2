{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Déboguer tp2 - Windows (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows/tp2.exe",
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "environment": [{ "name": "PATH", "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }],
            "preLaunchTask": "CMake: compiler"
        },
        {
            "name": "Déboguer tp2 - Mac / Linux (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux/tp2",
            "osx": { "program": "${workspaceFolder}/build/macos/tp2" },
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "preLaunchTask": "CMake: compiler"
        }
    ]
}
